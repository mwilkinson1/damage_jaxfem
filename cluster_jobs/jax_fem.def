Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%labels
    Author "Mark Wilkinson"
    Description "JAX-FEM + FEniCS (conda-forge) environment for Negishi"

%files
    environment_minimal.yml /opt/environment_minimal.yml

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        libglu1-mesa \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libxft2 \
        libxrender1 \
        libxext6 \
        libx11-6 \
        libfontconfig1 \
        libfreetype6 \
        libxfixes3
    rm -rf /var/lib/apt/lists/*

    micromamba create -y -n test_env -f /opt/environment_minimal.yml
    micromamba clean -a -y

%environment
    # Activate by path-like behavior: put env bin first
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/envs/test_env/bin:$PATH

    # Avoid writing caches into home if you prefer (optional)
    export XDG_CACHE_HOME=/tmp/$USER/.cache
    export MPLCONFIGDIR=/tmp/$USER/.config/matplotlib

%runscript
    exec "$@"